---
import { email, linkedin } from "../data/about";

const year = new Date().getFullYear();

const navLinks = [
  { label: "Sobre", href: "#sobre" },
  { label: "Jornada", href: "#jornada" },
  { label: "Cases", href: "#cases" },
  { label: "Contato", href: "#contato" },
];
---

<footer class="bg-navy-dark text-bg py-12 border-t border-bg/10" aria-label="Rodapé">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Desktop: 3 columns / Mobile: stacked centered -->
    <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start sm:justify-between">

      <!-- Column 1: Name + role -->
      <div class="text-center sm:text-left">
        <p class="font-display text-2xl text-bg mb-1">Evelin Parreira</p>
        <p class="text-xs text-bg/50 uppercase tracking-widest">
          Product Owner · APM · Product Manager
        </p>
      </div>

      <!-- Column 2: Quick links -->
      <nav aria-label="Links rápidos do rodapé">
        <ul class="flex flex-col items-center sm:items-start gap-2">
          {navLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-sm text-bg/60 hover:text-bg transition-colors"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 3: Contact + copyright -->
      <div class="flex flex-col items-center sm:items-end gap-3">
        <a
          href={`mailto:${email}`}
          class="text-sm text-bg/70 hover:text-lime transition-colors"
        >
          {email}
        </a>
        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-bg/70 hover:text-lime transition-colors"
        >
          LinkedIn
        </a>
        <p class="text-xs text-bg/30 mt-2">© {year} Evelin Parreira</p>
      </div>

    </div>
  </div>
</footer>
