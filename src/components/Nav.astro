---
import { linkedin } from "../data/about";
---

<header
  id="nav"
  class="fixed top-0 inset-x-0 z-50 flex items-center transition-all duration-300"
  style="height: 72px;"
  aria-label="Navegação principal"
>
  <div class="max-w-7xl mx-auto w-full px-10 flex items-center justify-between">

    <a href="/" class="nav-logo-eve" aria-label="Evelin Parreira — início">EVE</a>

    <nav class="flex items-center gap-12" aria-label="Menu principal">
      <a href="#sobre" class="nav-link">Sobre</a>
      <a href="#jornada" class="nav-link">Jornada</a>
      <a href="#cases" class="nav-link">Cases</a>
      <a href="/case-estudos/emanapay" class="nav-link flex items-center gap-1.5">
        Lab
        <span class="text-[0.55rem] font-bold uppercase tracking-widest bg-lime text-navy px-1.5 py-0.5 rounded-full leading-none">novo</span>
      </a>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link flex items-center gap-2"
        aria-label="LinkedIn de Evelin Parreira"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" fill="currentColor"/>
        </svg>
        LinkedIn
      </a>
    </nav>

  </div>
</header>

<script>
  const nav = document.getElementById("nav")!;
  function updateNav() {
    if (window.scrollY > 40) {
      nav.classList.add("bg-bg/90", "backdrop-blur-md", "shadow-sm", "border-b", "border-border");
    } else {
      nav.classList.remove("bg-bg/90", "backdrop-blur-md", "shadow-sm", "border-b", "border-border");
    }
  }
  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();
</script>
