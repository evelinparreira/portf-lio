---
import { bio, stats, skills } from "../data/about";
---

<section
  id="sobre"
  class="py-24 bg-bg-card border-y border-border"
  aria-labelledby="about-title"
>
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section label -->
    <p class="text-xs font-semibold tracking-widest uppercase text-red-accent mb-3" aria-hidden="true">
      Sobre mim
    </p>

    <!-- 3-column grid -->
    <div class="grid md:grid-cols-3 gap-12 lg:gap-16 items-start fade-up">

      <!-- Column 1: Title + Bio -->
      <div class="md:col-span-1">
        <h2 id="about-title" class="font-display text-4xl lg:text-5xl text-navy mb-6 leading-tight">
          Sobre mim
        </h2>
        <p class="text-base text-text-muted leading-relaxed">
          {bio}
        </p>
      </div>

      <!-- Column 2: Stats -->
      <div class="flex flex-col gap-8">
        <h3 class="sr-only">Números</h3>
        {stats.map((s) => (
          <div class="border-l-2 border-navy pl-5">
            <p class="text-4xl font-bold text-navy leading-none mb-1">{s.value}</p>
            <p class="text-sm text-text-muted">{s.label}</p>
          </div>
        ))}
      </div>

      <!-- Column 3: Skills -->
      <div>
        <h3 class="text-sm font-semibold text-navy uppercase tracking-widest mb-5">Vivências</h3>
        <div class="flex flex-wrap gap-2" role="list" aria-label="Habilidades e vivências">
          {skills.map((skill) => (
            <span
              role="listitem"
              class="text-sm font-medium px-3 py-1.5 rounded-full bg-bg border border-border text-text-muted hover:border-navy hover:text-navy transition-colors"
            >
              {skill}
            </span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
