---
import type { CollectionEntry } from "astro:content";

interface Props {
  currentId: string;
  cases: CollectionEntry<"cases">[];
}

const { currentId, cases } = Astro.props;
const idx = cases.findIndex((c) => c.id === currentId);
const prev = cases[(idx - 1 + cases.length) % cases.length];
const next = cases[(idx + 1) % cases.length];
---

<nav aria-label="Navegação entre cases" class="border-t border-border">
  <div class="max-w-[720px] mx-auto px-6 py-10 flex justify-between items-start gap-8">

    <!-- Anterior -->
    <a href={`/cases/${prev.id}`} class="group flex flex-col gap-1 max-w-[45%]">
      <span class="flex items-center gap-1.5 text-[0.68rem] font-medium text-text-muted uppercase tracking-widest group-hover:text-navy transition-colors">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M9 6H3M5 3L3 6l2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Anterior
      </span>
      <span class="text-[0.875rem] font-medium text-navy leading-snug group-hover:underline underline-offset-2 decoration-navy/30">
        {prev.data.title}
      </span>
    </a>

    <!-- Divisor vertical -->
    <span class="w-px self-stretch bg-border flex-shrink-0" aria-hidden="true"></span>

    <!-- Próximo -->
    <a href={`/cases/${next.id}`} class="group flex flex-col gap-1 max-w-[45%] text-right ml-auto">
      <span class="flex items-center justify-end gap-1.5 text-[0.68rem] font-medium text-text-muted uppercase tracking-widest group-hover:text-navy transition-colors">
        Próximo
        